<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Shizuku API（官方 demo 标准声明；缺 provider 时 requestPermission 完全不工作） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <provider
        android:name="rikka.shizuku.ShizukuProvider"
        android:authorities="${applicationId}.shizuku"
        android:multiprocess="false"
        android:enabled="true"
        android:exported="true"
        android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    <application
        android:name=".ErbianApp"
        android:label="耳边"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Erbian"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 助理兜底入口：系统走 ACTION_ASSIST activity 路径时也能到我们 -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 长按电源键唤醒（设计文档 §二 标准三件套） -->
        <service
            android:name=".voice.AssistInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":assist">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assist_interaction" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".voice.AssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:process=":assist" />

        <service
            android:name=".voice.AssistRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_RECOGNITION"
            android:process=":assist" />

        <!-- 浮层吊命：会话结束解绑后 :assist 被秒回收会带走悬浮窗（2026-10-15 实锤） -->
        <service
            android:name=".voice.AssistKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":assist">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="voice assistant wake overlay panel" />
        </service>
    </application>
</manifest>
